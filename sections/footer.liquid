{% comment %}
  Footer section with links and information
{% endcomment %}

<footer class="footer">
  <div class="container">
    <!-- Footer Main Content -->
    <div class="footer-content">
      <!-- Company Info -->
      <div class="footer-section">
        <div class="footer-logo">
          {% if settings.logo != blank %}
            <img
              src="{{ settings.logo | img_url: '150x' }}"
              alt="{{ shop.name }}"
              class="footer-logo-image">
          {% else %}
            <img
              src="{{ 'image1.jpg' | asset_url }}"
              alt="{{ shop.name }}"
              class="footer-logo-image">
          {% endif %}
        </div>
        <p class="footer-description">
          Discover a new way to dress with Point Store. Second-hand clothing carefully selected for style, quality, and prices from S/9.90. Each piece has a story… and deserves a second chance!
        </p>
        <div class="footer-social">
          <h4>Follow Us</h4>
          <div class="social-links">
            <a
              href="https://www.facebook.com/share/1A1ejGoDvC/"
              class="social-link"
              aria-label="Facebook"
              target="_blank"
              rel="noopener noreferrer">
              <i class="fa-brands fa-facebook-f"></i>
            </a>
            <a
              href="https://www.instagram.com/pointstoreperu?igsh=YW9pYmFxdmoxNjd0"
              class="social-link"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer">
              <i class="fa-brands fa-instagram"></i>
            </a>
            <a
              href="#"
              class="social-link"
              aria-label="Twitter">
              <i class="fa-brands fa-twitter"></i>
            </a>
            <a
              href="#"
              class="social-link"
              aria-label="TikTok">
              <i class="fa-brands fa-tiktok"></i>
            </a>
          </div>

          <!-- Language selector moved to header for easier access -->

        </div>
      </div>


      <!-- Customer Service -->
      <div class="footer-section">
        <h4>Customer Service</h4>
        <ul class="footer-links">
          <li>
            <a href="/pages/contact">Contact Us</a>
          </li>
          <li>
            <a href="/pages/shipping-info">Shipping Information</a>
          </li>
          <li>
            <a href="/pages/sales-policy">Sales Policy</a>
          </li>
          <li>
            <a href="/pages/track-order">Order Tracking</a>
          </li>
          <li>
            <a href="/pages/complaints">Complaints</a>
          </li>
        </ul>
      </div>

      <!-- Company Info -->
      <div class="footer-section">
        <h4>Company</h4>
        <ul class="footer-links">
          <li>
            <a href="/pages/about">About Us</a>
          </li>
          <li>
            <a href="/pages/sustainability">Sustainable Fashion</a>
          </li>
        </ul>
        <!-- Footer Newsletter (moved here after Partnerships) -->
        <div class="footer-newsletter">
          <h5 style="text-align: left; align-self: flex-start">Subscribe</h5>
          <h3 class="footer-newsletter-title">Subscribe and receive news and exclusive promotions. Dress with style, conscience, and attitude with Point Store.</h3>

          <!-- Email subscribe form -->
          <form id="footer-newsletter-email-form" class="footer-newsletter-form footer-newsletter-form--single">
            <input
              type="email"
              name="contact[email]"
              class="footer-newsletter-input"
              placeholder="Enter your email address"
              required>
            <button type="submit" class="footer-newsletter-btn">Subscribe</button>
          </form>

          <!-- Phone subscribe form -->
